---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import InferenceDemo from "../components/InferenceDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import { site, skills } from "../site.config";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base>
  <Hero />

  <section class="section wrap" id="demo">
    <div class="section-head"><span class="idx">[01]</span> live demo</div>
    <h2 class="section-title">A language model, running on my C++ engine, in your browser.</h2>
    <p class="lede">
      This is a 15M-parameter Llama-2-style transformer trained on children's stories. The inference engine is about 1,000
      lines of C++ (int8 weights, SIMD kernels, KV cache) compiled to WebAssembly. Load it, give it a story opening,
      and hover any word to see what else the model considered.
    </p>
    <InferenceDemo />
    <HowItWorks />
  </section>

  <section class="section wrap" id="about">
    <div class="section-head"><span class="idx">[02]</span> about</div>
    <div class="about">
      <div>
        <h2 class="section-title">Performance is a feature. I measure it.</h2>
        <p>
          I'm a software engineer who likes the layer where software meets hardware: memory layout, branch behaviour,
          cache lines, and the profile that shows where the time actually goes. C++ is my favourite tool because it
          lets me control all of that.
        </p>
        <p>
          I'm moving toward <strong>trading</strong> and <strong>AI infrastructure</strong>, where latency and
          throughput are the product. In both fields, small changes to a hot loop add up across millions of
          events or tokens.
        </p>
        <p class="mono small">
          <a href={`mailto:${site.links.email}`}>{site.links.email}</a> ·{" "}
          <a href={site.links.github}>github</a> ·{" "}
          <a href={site.links.linkedin}>linkedin</a>
        </p>
      </div>
      <dl class="skills panel">
        {
          skills.map((s) => (
            <div>
              <dt class="mono">{s.group}</dt>
              <dd>
                {s.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section wrap" id="projects">
    <div class="section-head"><span class="idx">[03]</span> projects</div>
    <h2 class="section-title">Selected work</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section wrap" id="experience">
    <div class="section-head"><span class="idx">[04]</span> experience</div>
    <div class="exp-head">
      <h2 class="section-title">Experience</h2>
      <a class="btn" href={`${base}${site.links.resume}`}>Download résumé (PDF) ↓</a>
    </div>
    <Timeline />
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .about p {
    color: var(--muted);
    max-width: 60ch;
  }
  .about strong {
    color: var(--text);
    font-weight: 600;
  }
  .small {
    font-size: 13px;
  }
  .skills {
    margin: 0;
  }
  .skills div {
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
  }
  .skills div:last-child {
    border-bottom: 0;
  }
  .skills dt {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .skills dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 14px;
  }
  .grid > :global(.featured) {
    grid-column: 1 / -1;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .exp-head .section-title {
    margin: 0;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
