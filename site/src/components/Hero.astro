---
import { site } from "../site.config";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const lines = [
  { cmd: "whoami", out: `${site.name}: software engineer` },
  { cmd: "cat focus.txt", out: site.tagline },
  { cmd: "./tlm --bench", out: "251 tok/s · wasm-simd128 · int8 · 70 KB binary" },
];
---

<section class="hero wrap">
  <div class="copy">
    <p class="kicker mono"><span class="dot"></span> open to roles in trading &amp; AI infrastructure</p>
    <h1>{site.headline}</h1>
    <p class="intro">{site.intro}</p>
    <div class="ctas">
      <a class="btn primary" href="#demo">▶ Run the model in your browser</a>
      <a class="btn" href={site.links.github}>GitHub</a>
      <a class="btn" href={site.links.linkedin}>LinkedIn</a>
      <a class="btn" href={`mailto:${site.links.email}`}>Email</a>
      <a class="btn" href={`${base}${site.links.resume}`}>Résumé ↓</a>
    </div>
  </div>

  <div class="term panel" aria-label="Terminal introduction">
    <div class="term-bar mono">
      <span class="lights"><i></i><i></i><i></i></span>
      <span>{site.handle}: ~</span>
    </div>
    <div class="term-body mono" id="hero-term">
      {
        lines.map((l) => (
          <div class="line" data-cmd={l.cmd} data-out={l.out}>
            <div>
              <span class="prompt">{site.handle}:~$</span> <span class="cmd">{l.cmd}</span>
            </div>
            <div class="out">{l.out}</div>
          </div>
        ))
      }
      <div><span class="prompt">{site.handle}:~$</span> <span class="cursor">▌</span></div>
    </div>
  </div>
</section>

<script>
  // Type the commands out once. The full text is server-rendered, so no-JS and
  // reduced-motion visitors just see the finished terminal.
  const term = document.getElementById("hero-term");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (term && !reduce) {
    const lines = [...term.querySelectorAll<HTMLElement>(".line")];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    lines.forEach((l) => {
      l.querySelector<HTMLElement>(".cmd")!.textContent = "";
      l.querySelector<HTMLElement>(".out")!.style.visibility = "hidden";
      l.style.display = "none";
    });
    (async () => {
      await sleep(250);
      for (const l of lines) {
        l.style.display = "";
        const cmd = l.querySelector<HTMLElement>(".cmd")!;
        for (const ch of l.dataset.cmd ?? "") {
          cmd.textContent += ch;
          await sleep(38 + Math.random() * 40);
        }
        await sleep(160);
        l.querySelector<HTMLElement>(".out")!.style.visibility = "";
        await sleep(280);
      }
    })();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-top: clamp(48px, 9vw, 112px);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--good) 22%, transparent);
  }
  h1 {
    font-size: clamp(34px, 5.2vw, 58px);
    font-weight: 680;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .intro {
    color: var(--muted);
    font-size: 17px;
    max-width: 54ch;
    margin: 22px 0 30px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .term {
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    font-size: 12px;
    color: var(--faint);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .term-body {
    padding: 18px 18px 22px;
    font-size: 13.5px;
    line-height: 1.75;
    min-height: 236px;
  }
  .line + .line,
  .line + div {
    margin-top: 10px;
  }
  .prompt {
    color: var(--good);
  }
  .out {
    color: var(--muted);
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .term-body {
      font-size: 12px;
      padding: 14px;
    }
  }
</style>
