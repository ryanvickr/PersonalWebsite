---
import { models } from "../site.config";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const examples = ["Once upon a time", "The little robot wanted", "Lily found a box", "Tom and his dog"];
---

<div class="demo panel" id="llm-demo" data-base={base} data-models={JSON.stringify(models)}>
  <header class="dh mono">
    <span class="status" data-state="idle"><i></i><b id="d-status">IDLE</b></span>
    <span class="meta" id="d-meta">int8 · C++20 → WebAssembly</span>
    <label class="model-pick">
      <span class="sr-only">Model</span>
      <select id="d-model">
        {models.map((m) => <option value={m.id}>{m.label} · {m.sizeMB} MB</option>)}
      </select>
    </label>
  </header>

  <div class="body">
    <div class="main">
      <form class="prompt" id="d-form" autocomplete="off">
        <span class="caret mono" aria-hidden="true">&gt;</span>
        <label class="sr-only" for="d-prompt">Prompt</label>
        <input id="d-prompt" class="mono" value="Once upon a time" maxlength="200" spellcheck="false" />
        <button class="btn primary" id="d-go" type="submit" disabled>Generate</button>
      </form>
      <div class="chips">
        {examples.map((e) => <button type="button" class="chip mono" data-prompt={e}>{e}</button>)}
      </div>

      <div class="out-wrap">
        <div class="out" id="d-out" aria-live="polite" data-heat="on"></div>
        <div class="gate" id="d-gate">
          <p class="gate-title">A 15M-parameter language model, running on your CPU.</p>
          <p class="gate-sub">
            Inference runs entirely in this tab: a C++ transformer engine compiled to WebAssembly. Nothing is sent to a
            server.
          </p>
          <button class="btn primary" id="d-load" type="button">Load model <span id="d-size"></span></button>
          <div class="progress" hidden id="d-progress"><span></span></div>
          <p class="gate-err mono" id="d-err" hidden></p>
        </div>
      </div>

      <footer class="ofoot mono">
        <label class="toggle"><input type="checkbox" id="d-heat" checked /> confidence heatmap</label>
        <span class="legend" aria-hidden="true"><i class="lo"></i>unsure <i class="hi"></i>confident</span>
        <span class="hint">hover a token to see what else the model considered</span>
      </footer>
    </div>

    <aside class="side">
      <div class="stats mono">
        <div><span class="k">tok/s</span><span class="v" id="s-tps">—</span></div>
        <div><span class="k">ms/token</span><span class="v" id="s-ms">—</span></div>
        <div><span class="k">tokens</span><span class="v" id="s-n">—</span></div>
        <div><span class="k">backend</span><span class="v small" id="s-backend">—</span></div>
        <div class="wide">
          <span class="k">context <span id="s-ctx">0 / 256</span></span>
          <span class="bar"><span id="s-ctx-bar"></span></span>
        </div>
      </div>

      <div class="block">
        <h4 class="mono">next-token distribution</h4>
        <ol class="topk mono" id="d-topk">
          {Array.from({ length: 5 }, () => <li><span class="t">·</span><span class="b"><span></span></span><span class="p">—</span></li>)}
        </ol>
      </div>

      <div class="block controls mono">
        <h4>sampling</h4>
        <label>temperature <output id="o-temp">0.8</output>
          <input type="range" id="c-temp" min="0" max="1.5" step="0.05" value="0.8" />
        </label>
        <label>top-p <output id="o-topp">0.90</output>
          <input type="range" id="c-topp" min="0.1" max="1" step="0.05" value="0.9" />
        </label>
        <label>max tokens <output id="o-max">200</output>
          <input type="range" id="c-max" min="16" max="255" step="1" value="200" />
        </label>
      </div>
    </aside>
  </div>
  <div class="tip mono" id="d-tip" role="tooltip" hidden></div>
</div>

<script>
  import { initDemo } from "../scripts/inference-ui";
  const root = document.getElementById("llm-demo");
  if (root) initDemo(root);
</script>

<style>
  .demo {
    position: relative;
    overflow: hidden;
  }
  .dh {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    font-size: 12px;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.08em;
  }
  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--faint);
  }
  .status[data-state="ready"] i {
    background: var(--good);
  }
  .status[data-state="busy"] i {
    background: var(--accent);
    animation: pulse 0.9s ease-in-out infinite;
  }
  .status[data-state="error"] i {
    background: var(--bad);
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .model-pick {
    margin-left: auto;
  }
  select {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font: 12px var(--mono);
    padding: 4px 6px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
  }
  .main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 18px;
    border-right: 1px solid var(--line);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 4px 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .prompt:focus-within {
    border-color: var(--accent);
  }
  .caret {
    color: var(--accent);
  }
  .prompt input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-size: 14px;
    height: 38px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 14px;
  }
  .chip {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    border-radius: 2px;
    padding: 3px 8px;
    font-size: 12px;
    cursor: pointer;
  }
  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .out-wrap {
    position: relative;
    flex: 1;
    min-height: 300px;
  }
  .out {
    height: 100%;
    min-height: 300px;
    max-height: 420px;
    overflow-y: auto;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: 17px;
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .out :global(.pr) {
    color: var(--muted);
  }
  .out :global(.tk) {
    border-radius: 2px;
    cursor: default;
  }
  .out[data-heat="on"] :global(.tk) {
    background: color-mix(in srgb, var(--accent) calc(var(--u, 0) * 55%), transparent);
  }
  .out :global(.tk:hover),
  .out :global(.tk.active) {
    outline: 1px solid var(--accent);
  }
  .out :global(.cur) {
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .out :global(.end) {
    display: block;
    margin-top: 12px;
    font: 12px var(--mono);
    color: var(--faint);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .gate {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }
  .gate[hidden] {
    display: none;
  }
  .gate-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .gate-sub {
    margin: 0 0 6px;
    max-width: 46ch;
    color: var(--muted);
    font-size: 14px;
  }
  .gate-err {
    margin: 0;
    color: var(--bad);
    font-size: 12px;
  }
  .progress {
    width: min(320px, 80%);
    height: 4px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  .ofoot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 10px;
    font-size: 11.5px;
    color: var(--faint);
  }
  .toggle {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
    color: var(--muted);
  }
  .toggle input {
    accent-color: var(--accent);
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend i {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid var(--line);
  }
  .legend .lo {
    background: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .legend .hi {
    background: transparent;
    margin-left: 6px;
  }
  .hint {
    margin-left: auto;
  }

  .side {
    display: flex;
    flex-direction: column;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .stats > div:nth-child(odd):not(.wide) {
    border-right: 1px solid var(--line);
  }
  .stats .wide {
    grid-column: 1 / -1;
    border-bottom: 0;
  }
  .k {
    font-size: 11px;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .v {
    font-size: 22px;
    font-weight: 500;
    color: var(--text);
  }
  .v.small {
    font-size: 13px;
    padding-top: 6px;
  }
  .bar {
    display: block;
    height: 4px;
    margin-top: 6px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }

  .block {
    padding: 14px;
    border-bottom: 1px solid var(--line);
  }
  .block:last-child {
    border-bottom: 0;
  }
  h4 {
    margin: 0 0 10px;
    font: 11px var(--mono);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .topk {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12.5px;
  }
  .topk li {
    display: grid;
    grid-template-columns: 92px 1fr 44px;
    align-items: center;
    gap: 8px;
    height: 24px;
  }
  .topk .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: pre;
  }
  .topk .b {
    height: 8px;
    background: var(--line);
    border-radius: 1px;
    overflow: hidden;
  }
  .topk .b span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.08s linear;
  }
  .topk li:first-child .t {
    color: var(--accent);
  }
  .topk .p {
    text-align: right;
    color: var(--muted);
  }

  .controls label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 8px;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .controls output {
    color: var(--text);
  }
  .controls input[type="range"] {
    grid-column: 1 / -1;
    width: 100%;
    accent-color: var(--accent);
  }

  .tip {
    position: absolute;
    z-index: 5;
    min-width: 200px;
    padding: 10px 12px;
    background: var(--panel-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5);
    font-size: 12px;
    pointer-events: none;
  }
  .tip :global(.row) {
    display: grid;
    grid-template-columns: 90px 1fr 40px;
    gap: 8px;
    align-items: center;
  }
  .tip :global(.row.chosen) {
    color: var(--accent);
  }
  .tip :global(.mini) {
    height: 6px;
    background: var(--line);
  }
  .tip :global(.mini span) {
    display: block;
    height: 100%;
    background: currentColor;
    opacity: 0.8;
  }
  .tip :global(.hdr) {
    color: var(--faint);
    margin-bottom: 6px;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .main {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats > div {
      border-right: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .main {
      padding: 12px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .meta,
    .hint {
      display: none;
    }
    .out {
      font-size: 15.5px;
      padding: 12px;
    }
  }
</style>
