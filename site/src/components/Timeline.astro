---
import { getCollection } from "astro:content";
const jobs = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
---

<ol class="timeline">
  {
    jobs.map((j) => (
      <li class:list={{ placeholder: j.data.placeholder }}>
        <div class="when mono">
          {j.data.start} — {j.data.end}
          {j.data.location && <span class="loc">{j.data.location}</span>}
        </div>
        <div class="what">
          <h3>
            {j.data.role} <span class="at">@ {j.data.org}</span>
          </h3>
          {j.data.highlights.length > 0 && (
            <ul>
              {j.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .when {
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .loc {
    color: var(--faint);
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
  }
  .at {
    color: var(--accent);
    font-weight: 500;
  }
  ul {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 15px;
  }
  ul li::marker {
    color: var(--faint);
  }
  .placeholder {
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
